DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barberbookings
DATABASE_SCHEMA=public
DATABASE_POOL_MAX=2
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
APP_ENV=development
# Required in Production. Development/Test defaults to barber with an explicit warning.
# Allowed values: barber, beauty.
BUSINESS_VERTICAL=barber
# Runtime theme. Explicit VITE_BRAND_THEME remains a backwards-compatible build override.
# Allowed values: classic-gold, beauty-clean. When omitted, follows BUSINESS_VERTICAL.
BUSINESS_THEME=classic-gold
# Optional deployment branding layered over the vertical defaults.
# Supported profile: ana-isabel (Beauty only). Leave blank for generic Beauty.
BUSINESS_BRANDING_PROFILE=
# Optional override. Beauty enables appointment availability windows by default;
# Barber keeps them disabled unless explicitly enabled after migration 0021.
BUSINESS_FEATURE_APPOINTMENT_AVAILABILITY_WINDOWS_ENABLED=
# Public branding precedence: DEMO_MODE, explicit VITE_SHOP_* overrides,
# active Business Profile defaults, then location-specific DB values.
# Opt-in timing diagnostics for Development only; always inert with APP_ENV=production.
PERFORMANCE_TIMINGS_ENABLED=false
# Production capabilities are fail-closed. Development keeps these enabled by default.
APPOINTMENT_NOTIFICATION_EVENTS_ENABLED=
NOTIFICATION_OUTBOX_WORKER_ENABLED=
# Disabled until migration 0022 and the Meta template are validated.
APPOINTMENT_REMINDERS_ENABLED=false
SESSION_SECRET=barberbookings-local-secret
# Safe default for existing installations. Switch only after migration 0015
# and the explicit legacy backfill/preflight have been completed.
AUTH_RUNTIME_MODE=legacy
# Canonical first-install setup only. Use a random value with at least 32 characters,
# open /setup once, then remove this value after the first administrator exists.
BOOTSTRAP_ADMIN_TOKEN=
PORT=5000
PUBLIC_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000
SESSION_SAME_SITE=lax
VITE_API_URL=
DEMO_MODE=false
ADMIN_INITIAL_PASSWORD=
DEMO_ADMIN_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# WhatsApp stays disabled unless both of the following values are explicitly changed in Development.
WHATSAPP_NOTIFICATIONS_ENABLED=false
MESSAGING_PROVIDER=none
WHATSAPP_DEFAULT_COUNTRY_CODE=351
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Meta WhatsApp Cloud API - isolated Development test only. Never commit real values.
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TEST_TEMPLATE=hello_world
META_WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
# Development template defaults. Production must explicitly configure every enabled template before enabling WhatsApp.
META_WHATSAPP_CONFIRMATION_TEMPLATE=appointment_confirmation_salon
META_WHATSAPP_CONFIRMATION_TEMPLATE_LANGUAGE=pt_PT
META_WHATSAPP_RESCHEDULED_TEMPLATE=appointment_rescheduled_salon
META_WHATSAPP_RESCHEDULED_TEMPLATE_LANGUAGE=pt_PT
# No Development default: configure only after the template is approved in the WABA used by that environment.
META_WHATSAPP_UPDATED_TEMPLATE=appointment_updated_salon
META_WHATSAPP_UPDATED_TEMPLATE_LANGUAGE=pt_PT
META_WHATSAPP_CANCELLED_TEMPLATE=appointment_cancelled_salon
META_WHATSAPP_CANCELLED_TEMPLATE_LANGUAGE=pt_PT
META_WHATSAPP_RECURRING_CONFIRMATION_TEMPLATE=appointment_recurring_confirmation_salon
META_WHATSAPP_RECURRING_CONFIRMATION_TEMPLATE_LANGUAGE=pt_PT
META_WHATSAPP_REMINDER_DAY_BEFORE_TEMPLATE=appointment_reminder_day_before_salon
META_WHATSAPP_REMINDER_DAY_BEFORE_TEMPLATE_LANGUAGE=pt_PT
# Configure only templates approved in the WABA used by the Beauty environment.
META_WHATSAPP_RECURRING_NOTIFICATIONS_ENABLED=false
META_WHATSAPP_DEV_ALLOWLIST=
META_WHATSAPP_WEBHOOK_ENABLED=false
META_WHATSAPP_INBOUND_AUTO_REPLY_ENABLED=false
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
# Migration-only values. Review them before migrating a Production database.
MIGRATION_DEFAULT_LOCATION_NAME=
MIGRATION_DEFAULT_LOCATION_ADDRESS=
MIGRATION_DEFAULT_LOCATION_TIME_ZONE=Europe/Lisbon
MIGRATION_DEFAULT_LOCATION_MAP_URL=
MIGRATION_DEFAULT_LOCATION_MAP_EMBED_URL=
SHOP_NAME=Baptista Barber Shop
SHOP_ADDRESS=Rua Comandante Agatão Lança Nº28
VITE_SHOP_NAME=Baptista Barber Shop
VITE_SHOP_SHORT_NAME=Baptista
VITE_SHOP_ADDRESS=Rua Comandante Agatão Lança Nº28
VITE_SHOP_LOGO_URL=/images/logo.jpg
# Optional public asset overrides. When omitted, the active Business Profile
# provides the horizontal mark and favicon/app icon.
VITE_SHOP_HORIZONTAL_LOGO_URL=
VITE_SHOP_ICON_URL=
VITE_SHOP_MAP_URL=https://www.google.com/maps/search/?api=1&query=Rua%20Comandante%20Agat%C3%A3o%20Lan%C3%A7a%20N%C2%BA28
VITE_SHOP_MAP_EMBED_URL=
VITE_HIDE_SHOP_MAP=false
VITE_USE_LEGACY_BARBER_AVATARS=true
VITE_BRAND_THEME=classic-gold
VITE_INSTAGRAM_URL=
# Optional public copy and metadata overrides. These are resolved server-side
# into /api/runtime-config and /manifest.webmanifest and reused by the client.
VITE_HERO_TITLE=
VITE_HERO_DESCRIPTION=
VITE_HERO_IMAGE_URL=
VITE_HERO_IMAGE_ALT=
VITE_HERO_PRIMARY_CTA_LABEL=
VITE_HERO_SECONDARY_CTA_LABEL=
VITE_HOME_SERVICES_TITLE=
VITE_HOME_TEAM_TITLE=
VITE_HOME_LOCATION_TITLE=
VITE_HOME_TEAM_DESCRIPTION=
VITE_META_TITLE=
VITE_META_DESCRIPTION=
VITE_SOCIAL_IMAGE_URL=
VITE_MANIFEST_NAME=
VITE_MANIFEST_SHORT_NAME=
VITE_MANIFEST_DESCRIPTION=
VITE_MANIFEST_BACKGROUND_COLOR=
VITE_MANIFEST_THEME_COLOR=
SHOP_TIME_ZONE=Europe/Lisbon
# Allowed values: 15, 30, 60. When omitted, the historical 30-minute interval is preserved.
BOOKING_SLOT_INTERVAL_MINUTES=30
PUBLIC_BOOKING_MONTHLY_WINDOW_ENABLED=false
PUBLIC_BOOKING_NEXT_MONTH_OPEN_DAY=20
MULTI_LOCATION_ENABLED=false
MAX_LOCATIONS=1
CANCELLATION_POLICY_HOURS=4
